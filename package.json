{
  "name": "axon-git",
  "displayName": "Git Axon",
  "description": "Review ahead commits by reading the final files, with the changes painted on top.",
  "version": "0.1.1",
  "publisher": "fervillanuevas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyppe-cc/git-axon.git"
  },
  "bugs": {
    "url": "https://github.com/hyppe-cc/git-axon/issues"
  },
  "homepage": "https://github.com/hyppe-cc/git-axon#readme",
  "icon": "media/logo.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitAxon",
          "title": "Git Axon",
          "icon": "media/axon.svg"
        }
      ]
    },
    "views": {
      "gitAxon": [
        {
          "id": "gitAxon.files",
          "name": "Review Files"
        },
        {
          "id": "gitAxon.commits",
          "name": "Commits"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitAxon.files",
        "contents": "No changes to review.\n[Refresh](command:gitAxon.refresh)\n[Choose Base Ref](command:gitAxon.chooseBase)"
      }
    ],
    "commands": [
      {
        "command": "gitAxon.openAllFiles",
        "title": "Open All Review Files",
        "category": "Git Axon",
        "icon": "$(files)"
      },
      {
        "command": "gitAxon.reviewSelectedCommits",
        "title": "Review Selected Commits (Open Their Files)",
        "category": "Git Axon",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitAxon.reviewAhead",
        "title": "Review Ahead Commits",
        "category": "Git Axon",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitAxon.openDiff",
        "title": "Open Diff Against Baseline",
        "category": "Git Axon",
        "icon": "$(diff)"
      },
      {
        "command": "gitAxon.toggleOverlay",
        "title": "Toggle Change Overlay",
        "category": "Git Axon",
        "icon": "$(eye)"
      },
      {
        "command": "gitAxon.chooseBase",
        "title": "Choose Base Ref for This Session…",
        "category": "Git Axon"
      },
      {
        "command": "gitAxon.refresh",
        "title": "Refresh",
        "category": "Git Axon",
        "icon": "$(refresh)"
      },
      {
        "command": "gitAxon.openFile",
        "title": "Open Review File",
        "category": "Git Axon"
      },
      {
        "command": "gitAxon.reviewCommit",
        "title": "Review Commit",
        "category": "Git Axon"
      },
      {
        "command": "gitAxon.addFileGroup",
        "title": "Add File Group…",
        "category": "Git Axon",
        "icon": "$(new-folder)"
      },
      {
        "command": "gitAxon.removeFileGroup",
        "title": "Remove File Group",
        "category": "Git Axon",
        "icon": "$(close)"
      },
      {
        "command": "gitAxon.toggleFolderView",
        "title": "Toggle Folder View",
        "category": "Git Axon",
        "icon": "$(list-tree)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitAxon.openFile",
          "when": "false"
        },
        {
          "command": "gitAxon.reviewCommit",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "gitAxon.openAllFiles",
          "when": "view == gitAxon.files",
          "group": "navigation@1"
        },
        {
          "command": "gitAxon.reviewAhead",
          "when": "view == gitAxon.files",
          "group": "navigation@2"
        },
        {
          "command": "gitAxon.refresh",
          "when": "view == gitAxon.files",
          "group": "navigation@3"
        },
        {
          "command": "gitAxon.chooseBase",
          "when": "view == gitAxon.files"
        },
        {
          "command": "gitAxon.reviewSelectedCommits",
          "when": "view == gitAxon.commits",
          "group": "navigation@1"
        },
        {
          "command": "gitAxon.reviewAhead",
          "when": "view == gitAxon.commits",
          "group": "navigation@2"
        },
        {
          "command": "gitAxon.refresh",
          "when": "view == gitAxon.commits",
          "group": "navigation@3"
        },
        {
          "command": "gitAxon.addFileGroup",
          "when": "view == gitAxon.files",
          "group": "navigation@4"
        },
        {
          "command": "gitAxon.toggleFolderView",
          "when": "view == gitAxon.files",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "gitAxon.reviewSelectedCommits",
          "when": "view == gitAxon.commits && viewItem == commit",
          "group": "inline"
        },
        {
          "command": "gitAxon.reviewSelectedCommits",
          "when": "view == gitAxon.commits && viewItem == commit",
          "group": "1_review"
        },
        {
          "command": "gitAxon.openDiff",
          "when": "view == gitAxon.files && viewItem == reviewFile",
          "group": "inline"
        },
        {
          "command": "gitAxon.removeFileGroup",
          "when": "view == gitAxon.files && viewItem == fileGroup",
          "group": "inline"
        },
        {
          "command": "gitAxon.removeFileGroup",
          "when": "view == gitAxon.files && viewItem == fileGroup",
          "group": "1_group"
        }
      ],
      "editor/title": [
        {
          "command": "gitAxon.openDiff",
          "when": "gitAxon.isReviewFile",
          "group": "navigation@90"
        },
        {
          "command": "gitAxon.toggleOverlay",
          "when": "gitAxon.isReviewFile",
          "group": "navigation@91"
        }
      ]
    },
    "colors": [
      {
        "id": "gitAxon.addedLineBackground",
        "description": "Background of added or modified lines in a review file.",
        "defaults": {
          "dark": "#2ea04333",
          "light": "#2ea04326",
          "highContrast": "#2ea04355",
          "highContrastLight": "#2ea04340"
        }
      },
      {
        "id": "gitAxon.removedMarker",
        "description": "Colour of the removed-lines marker and badge in a review file.",
        "defaults": {
          "dark": "#f85149",
          "light": "#cf222e",
          "highContrast": "#ff7b72",
          "highContrastLight": "#a40e26"
        }
      }
    ],
    "configuration": {
      "title": "Git Axon",
      "properties": {
        "gitAxon.includeUntracked": {
          "type": "boolean",
          "default": true,
          "description": "Include untracked (new, not ignored) files in the ahead review."
        },
        "gitAxon.historyLimit": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "How many commits the Commits view lists."
        },
        "gitAxon.openAllConfirmThreshold": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "description": "Ask before opening more than this many files at once."
        },
        "gitAxon.autoOpenFiles": {
          "type": "boolean",
          "default": false,
          "description": "Open all review files automatically when the window starts."
        },
        "gitAxon.fileGroups": {
          "type": "array",
          "default": [
            {
              "name": "Test Files",
              "pattern": "(\\.|/)(test|spec)\\.[^/]+$|(^|/)(tests?|__tests__)/"
            }
          ],
          "description": "Groups for the Review Files view. A file goes to the first group whose pattern (a regular expression on the file path) matches; files matching none are listed under \"Regular Files\".",
          "items": {
            "type": "object",
            "required": [
              "name",
              "pattern"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Group title."
              },
              "pattern": {
                "type": "string",
                "description": "Regular expression matched against the file path."
              }
            }
          }
        }
      }
    }
  },
  "dependencies": {
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
